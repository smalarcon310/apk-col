/**
 * Environment Configuration
 * Variables de entorno para desarrollo
 */

# Remote API Configuration
# Cambiar TU_IP_PUBLICA por la dirección IP o dominio real del servidor
REACT_APP_API_BASE_URL=http://TU_IP_PUBLICA:3002
# Para desarrollo local:
# REACT_APP_API_BASE_URL=http://localhost:3002

# Environment
REACT_APP_ENVIRONMENT=development
SESSION_SECRET=define-a-long-random-secret

# MySQL API (server-side only)
API_PORT=3002
CLIENT_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=serma_db

# Gemini API (server-side only; never expose this value as REACT_APP_*)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
