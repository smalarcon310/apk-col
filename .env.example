/**
 * Environment Configuration
 * Variables de entorno para desarrollo
 * Reemplazar con tus credenciales de Firebase
 */

# Remote API Configuration
# Cambiar TU_IP_PUBLICA por la dirección IP o dominio real del servidor
REACT_APP_API_BASE_URL=http://TU_IP_PUBLICA:3002
# Para desarrollo local:
# REACT_APP_API_BASE_URL=http://localhost:3002

# Emulador (solo desarrollo local)
REACT_APP_USE_EMULATOR=false

# Environment
REACT_APP_ENVIRONMENT=development

# MySQL API (server-side only)
API_PORT=3002
CLIENT_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=serma_db

